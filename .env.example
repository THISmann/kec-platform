# ─────────────────────────────────────────────────────────────
#  KEC — variables d'environnement
# ─────────────────────────────────────────────────────────────
# mock : données simulées (localStorage) — aucun serveur requis
# http : appels REST réels vers VITE_API_BASE_URL
VITE_API_MODE=mock

# URL de base de l'API réelle (utilisée seulement en mode http)
VITE_API_BASE_URL=http://localhost:8080/api

# Latence simulée des mocks en ms (pour voir les états de chargement)
VITE_MOCK_LATENCY=450
